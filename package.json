{
  "name": "aivance-website",
  "version": "2.0.0",
  "description": "AIVANCE – Digitalisierungsagentur Rhein-Main (statische Website, Eleventy)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i src/css/main.css -o _site/css/main.css --minify",
    "build:11ty": "eleventy",
    "build": "npm run build:11ty && npm run build:css",
    "watch:css": "tailwindcss -i src/css/main.css -o _site/css/main.css --watch",
    "dev": "eleventy --serve"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aivancegbr/aivance-website.git"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource/inter": "^5.3.0",
    "tailwindcss": "^3.4.19"
  }
}
