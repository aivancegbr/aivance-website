---
layout: layouts/base.njk
pagination:
  data: projects
  size: 1
  alias: projekt
  addAllPagesToCollections: true
permalink: "/projekte/{{ projekt.slug }}/"
eleventyComputed:
  enUrl: "/en/projekte/{{ projekt.slug }}/"
  title: "{{ projekt.meta.title }}"
  metaTitle: "{{ projekt.meta.title }}"
  metaDescription: "{{ projekt.meta.description }}"
  breadcrumb: "{{ projekt.title }}"
---

{# Template T4 — Projektseite (§ 7): Ausgangslage → Lösung → Was wir gebaut haben → Tech-Tags → Ergebnisse → Zitat #}
{% set brancheData = industries | findBySlug(projekt.branche) %}

<section class="py-16">
  <div class="max-w-6xl mx-auto px-5">
    <div class="flex items-center gap-3 mb-6">
      <div class="w-8 h-8 rounded-lg bg-slate-900 text-white flex items-center justify-center text-xs font-black flex-shrink-0" aria-hidden="true">{{ projekt.nummer }}</div>
      <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">{{ projekt.brancheLabel }}</span>
      <span class="ml-auto px-3 py-1 bg-emerald-50 text-emerald-700 text-[10px] font-semibold border border-emerald-100">✓ {{ projekt.status }}</span>
    </div>
    <h1 class="max-w-3xl text-4xl font-black text-slate-900 mb-2">{{ projekt.title }}</h1>
    <p class="mono max-w-2xl text-[11px] tracking-widest uppercase text-ink-muted">{{ projekt.untertitel }}</p>
  </div>
</section>

<section class="py-16">
  <div class="prose-col-wide">
    <div class="grid md:grid-cols-2 gap-10 mb-10">
      <div class="reveal">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Ausgangslage</h2>
        <p class="text-sm text-slate-600 leading-relaxed">{{ projekt.ausgangslage }}</p>
      </div>
      <div class="reveal reveal-1">
        <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3">Lösung</h2>
        <p class="text-sm text-slate-600 leading-relaxed">{{ projekt.loesung }}</p>
      </div>
    </div>

    {% if projekt.bild %}
    <div class="reveal mb-10 rounded-2xl overflow-hidden border border-slate-100 shadow-card">
      <img src="{{ projekt.bild }}" alt="{{ projekt.bildAlt }}" width="1200" height="675" loading="lazy" class="w-full object-cover" />
    </div>
    {% endif %}

    <div class="reveal mb-10">
      <h2 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Was wir gebaut haben</h2>
      <div class="space-y-2.5">
        {% for punkt in projekt.gebaut %}
        <div class="flex items-start gap-3">
          <span class="w-5 h-5 rounded-full bg-emerald-100 flex items-center justify-center mt-0.5 flex-shrink-0" aria-hidden="true">
            <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
          </span>
          <p class="text-sm text-slate-600">{{ punkt }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    <div class="reveal flex flex-wrap gap-2 mb-12">
      {% for tag in projekt.tech %}
      <span class="px-3 py-1.5 rounded-lg bg-slate-50 border border-slate-100 text-slate-600 text-xs font-semibold">{{ tag }}</span>
      {% endfor %}
    </div>

    <!-- Messbare Ergebnisse -->
    <div class="reveal bg-slate-50 rounded-3xl border border-slate-100 p-8 mb-8">
      <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-6">{{ projekt.ergebnisZeitraum }}</p>
      <div class="grid sm:grid-cols-3 gap-4">
        {% for erg in projekt.ergebnisse %}
        <div class="bg-white rounded-2xl border border-slate-100 p-5 text-center">
          <p class="text-2xl font-black text-slate-900">{{ erg.wert }}</p>
          <p class="text-sm font-bold text-slate-700 mt-1">{{ erg.label }}</p>
          <p class="text-xs text-slate-400 mt-1">{{ erg.detail }}</p>
        </div>
        {% endfor %}
      </div>
    </div>

    <!-- Zitat -->
    {% if projekt.zitat %}
    <div class="reveal bg-slate-900 rounded-2xl p-7 mb-4">
      <div class="flex gap-0.5 mb-4" aria-hidden="true">
        <span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span><span class="star">★</span>
      </div>
      <p class="text-white leading-relaxed italic mb-6">"{{ projekt.zitat.text }}"</p>
      <div>
        <p class="text-white/80 text-sm font-semibold">{{ projekt.zitat.autor }}</p>
        <p class="text-white/40 text-xs">{{ projekt.zitat.ort }}</p>
      </div>
    </div>
    {% endif %}
    {% if projekt.anonym %}
    <p class="text-xs text-slate-400">Auf Wunsch des Kunden anonymisiert dargestellt.</p>
    {% endif %}
  </div>
</section>

{% include "partials/leitplanken.njk" %}

{% set ctaHeadline = "Ihr Projekt als Nächstes?" %}
{% set ctaSecondaryUrl = "/projekte/" %}
{% set ctaSecondaryLabel = "Alle Case Studies" %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": {{ projekt.title | dump | safe }},
  "about": {{ projekt.brancheLabel | dump | safe }},
  "description": {{ projekt.meta.description | dump | safe }},
  "creator": { "@type": "Organization", "name": "AIVANCE", "url": "{{ site.url }}" }
}
</script>
