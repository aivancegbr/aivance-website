      <h2 class="section-h2 reveal">Products we<br/>build ourselves.</h2>
      <p class="lede max-w-md reveal reveal-1">What has come up more than once in client work, we develop into a product of our own — on the same principle: every answer carries its source.</p>
    </div>
    <div class="grid sm:grid-cols-2 {{ 'lg:grid-cols-4' if products.length == 4 else 'lg:grid-cols-3' }} border border-line reveal">
      {% for produkt in products %}
      <a href="/en/produkte/#{{ produkt.slug }}" class="p-7 border-line hover:bg-surface transition-colors {{ 'border-b sm:border-b lg:border-b-0' if not loop.last }} {{ 'sm:border-r' if loop.index % 2 == 1 }} lg:border-r lg:last:border-r-0">
        <div class="flex items-baseline justify-between gap-3 mb-5">
          <span class="eyebrow eyebrow-muted text-[11px]">{{ produkt.nummer }}</span>
