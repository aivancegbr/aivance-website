        { nr: "03", titel: "Implementation", text: "A clearly scoped first step at a fixed price, with checkpoints instead of surprises." },
        { nr: "04", titel: "Ongoing support", text: "Operations, maintenance and further development — with a dedicated contact and agreed response times." }
      ] %}
