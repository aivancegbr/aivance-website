    <h2 class="section-h2 mb-12 max-w-2xl reveal">Three areas, one connected system</h2>
    <div class="grid md:grid-cols-3 gap-5">
      {% for cluster in clusters %}
      {% set ec = enClusters[cluster.slug] %}
      <a href="/en/leistungen/{{ cluster.slug }}/" class="card reveal reveal-{{ loop.index }} block p-7">
        <span class="eyebrow eyebrow-muted mb-6 text-[11px]">0{{ loop.index }}</span>
