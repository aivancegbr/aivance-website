        { img: "profilecyrus.jpg", name: "Cyrus Lang", rolle: "Co-founder", text: "Builds the client-facing AI systems: RAG knowledge systems, phone assistants and end-to-end automation. Also responsible for AIVANCE's growth.", mail: "cyrus.lang@ai-vance.de" }
