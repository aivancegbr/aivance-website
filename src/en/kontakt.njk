<section class="py-16 bg-slate-50 border-b border-slate-100">
  <div class="max-w-3xl mx-auto px-5 text-center">
    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">Contact</p>
    <h1 class="text-5xl font-black text-slate-900 mb-4">Free introductory call</h1>
    <p class="text-slate-500 leading-relaxed max-w-lg mx-auto">No sales pitch: we listen, ask questions, and tell you honestly whether and how we can help. Reply usually within 24 hours.</p>
  </div>
</section>

<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid lg:grid-cols-2 gap-14 items-start">
      <div class="reveal">
        <h2 class="text-2xl font-black text-slate-900 mb-4">How to reach us</h2>
        <p class="text-slate-500 text-sm leading-relaxed mb-8 max-w-sm">Directly by email or phone — or via the form, if you'd like to briefly describe what you have in mind.</p>
        <div class="space-y-3 mb-10">
          <a href="mailto:{{ site.email }}" class="flex items-center gap-3 text-sm text-slate-500 hover:text-blue-600 transition-colors">
            <span class="w-9 h-9 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </span>
            {{ site.email }}
          </a>
          <a href="tel:{{ site.phoneHref }}" class="flex items-center gap-3 text-sm text-slate-500 hover:text-blue-600 transition-colors">
            <span class="w-9 h-9 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </span>
            {{ site.phone }}
          </a>
          <p class="flex items-center gap-3 text-sm text-slate-500">
            <span class="w-9 h-9 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center" aria-hidden="true">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </span>
            {{ site.address.street }}, {{ site.address.zip }} {{ site.address.city }}, Germany
          </p>
        </div>

        <div class="bg-slate-50 rounded-2xl border border-slate-100 p-6">
          <p class="text-xs font-semibold text-slate-700 uppercase tracking-wide mb-3">What happens after your inquiry</p>
          <ol class="space-y-2 text-sm text-slate-500 list-decimal pl-4">
            <li>We get back to you within 24 hours with a proposed date.</li>
            <li>Introductory call (30–45 minutes, phone or video) — free of charge.</li>
            <li>You receive an honest assessment: what makes sense, what doesn't, and what the first step would cost.</li>
          </ol>
        </div>
      </div>
      {% include "partials/kontakt-form.njk" %}
    </div>
  </div>
</section>
