---
layout: layouts/base.njk
lang: en
pagination:
  data: clusters
  size: 1
  alias: cluster
  addAllPagesToCollections: true
permalink: "/en/leistungen/{{ cluster.slug }}/"
eleventyComputed:
  deUrl: "/leistungen/{{ cluster.slug }}/"
  title: "{{ cluster.en.meta.title or cluster.meta.title }}"
  metaTitle: "{{ cluster.en.meta.title or cluster.meta.title }}"
  metaDescription: "{{ cluster.en.meta.description or cluster.meta.description }}"
  breadcrumb: "{{ cluster.en.title or cluster.title }}"
---

{# Template T1 — cluster page, English mirror of /leistungen/[slug]/ #}
{% set d = cluster.en %}

<!-- 1 · Hero (compact) -->
<section class="py-16 bg-slate-50 border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-5 text-center">
    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">{{ d.claim or cluster.claim }}</p>
    <h1 class="text-5xl font-black text-slate-900 mb-4">{{ d.title or cluster.title }}</h1>
    <p class="text-slate-500 max-w-lg mx-auto leading-relaxed">{{ d.heroSatz or cluster.heroSatz }}</p>
  </div>
</section>

<!-- 2 · Three service cards -->
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid md:grid-cols-3 gap-5">
      {% for serviceSlug in cluster.services %}
      {% set service = services | findBySlug(serviceSlug) %}
      {% set sd = service.en %}
      <a href="/en/leistungen/{{ service.slug }}/" class="reveal reveal-{{ loop.index }} block bg-white rounded-2xl border border-slate-100 p-7 shadow-card hover:-translate-y-1 transition-transform">
        <h2 class="font-bold text-slate-900 text-lg mb-2">{{ sd.title or service.title }}</h2>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ sd.card or service.card }}</p>
        <p class="text-xs text-slate-400 mb-4">{{ (sd.zeitrahmen or service.zeitrahmen) | truncate(90) }}</p>
        <span class="text-sm font-semibold text-blue-600">View details →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 3 · Why a single source -->
<section class="py-16 bg-slate-50/50">
  <div class="max-w-3xl mx-auto px-5 text-center reveal">
    <h2 class="text-3xl font-black text-slate-900 mb-4">Why from a single source?</h2>
    <p class="text-slate-500 leading-relaxed">{{ d.verzahnung or cluster.verzahnung }}</p>
  </div>
</section>

<!-- 4 · Case studies filtered to this cluster -->
{% set clusterProjekte = [] %}
{% for projekt in projects %}
  {% if cluster.slug in projekt.cluster %}
    {% set clusterProjekte = (clusterProjekte.push(projekt), clusterProjekte) %}
  {% endif %}
{% endfor %}
{% if clusterProjekte.length %}
<section class="py-20 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-center mb-12 reveal">
      <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">Case studies</p>
      <h2 class="text-3xl font-black text-slate-900">Results from this area</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-5 max-w-4xl mx-auto">
      {% for projekt in clusterProjekte %}
      {% set pd = projekt.en %}
      <a href="/en/projekte/{{ projekt.slug }}/" class="reveal reveal-{{ loop.index }} block bg-slate-50 rounded-2xl border border-slate-100 p-7 hover:border-blue-200 transition-colors">
        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4">{{ pd.brancheLabel or projekt.brancheLabel }}</p>
        <p class="text-4xl font-black text-slate-900">{{ pd.teaser.zahl or projekt.teaser.zahl }}</p>
        <p class="text-sm text-blue-600 font-semibold mb-3">{{ pd.teaser.zahlLabel or projekt.teaser.zahlLabel }}</p>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ pd.teaser.text or projekt.teaser.text }}</p>
        <span class="text-sm font-semibold text-blue-600">View case study →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- 5 · Guardrails strip (compact) -->
{% include "partials/leitplanken.njk" %}

<!-- 6 · CTA block -->
{% set ctaSecondaryUrl = "/en/leistungen/" %}
{% set ctaSecondaryLabel = "All services" %}
{% include "partials/cta.njk" %}
