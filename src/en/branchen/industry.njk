---
layout: layouts/base.njk
lang: en
pagination:
  data: industries
  size: 1
  alias: branche
  addAllPagesToCollections: true
permalink: "/en/branchen/{{ branche.slug }}/"
eleventyComputed:
  deUrl: "/branchen/{{ branche.slug }}/"
  title: "{{ branche.en.meta.title or branche.meta.title }}"
  metaTitle: "{{ branche.en.meta.title or branche.meta.title }}"
  metaDescription: "{{ branche.en.meta.description or branche.meta.description }}"
  breadcrumb: "{{ branche.en.title or branche.title }}"
---

{# Template T3 — industry page, English mirror of /branchen/[slug]/ #}
{% set d = branche.en %}

<!-- 1 · Hero -->
<section class="py-16 bg-slate-50 border-b border-slate-100">
  <div class="max-w-3xl mx-auto px-5 text-center">
    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">{{ site.region }}</p>
    <h1 class="text-5xl font-black text-slate-900 mb-4">{{ d.hero or branche.hero }}</h1>
    <p class="text-slate-500 leading-relaxed max-w-lg mx-auto">{{ d.heroSatz or branche.heroSatz }}</p>
  </div>
</section>

<!-- 2 · Industry-specific pain points -->
<section class="py-16 bg-white">
  <div class="max-w-3xl mx-auto px-5">
    <h2 class="text-2xl font-black text-slate-900 mb-6">Where it hurts</h2>
    <div class="space-y-3">
      {% for punkt in d.schmerzpunkte or branche.schmerzpunkte %}
      <div class="reveal reveal-{{ loop.index }} bg-slate-50 rounded-2xl border border-slate-100 p-5">
        <p class="font-bold text-slate-800 text-sm mb-1.5">{{ punkt.titel }}</p>
        <p class="text-sm text-slate-500 leading-relaxed">{{ punkt.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 3 · Legal framework block -->
{% set rr = d.rechtsrahmen or branche.rechtsrahmen %}
<section class="py-16 bg-slate-50/50">
  <div class="max-w-3xl mx-auto px-5">
    <h2 class="text-2xl font-black text-slate-900 mb-4">Legal framework</h2>
    <p class="text-sm text-slate-500 leading-relaxed mb-6">{{ rr.intro }}</p>
    <div class="bg-white rounded-2xl border border-slate-100 p-6">
      <ul class="space-y-2.5">
        {% for punkt in rr.punkte %}
        <li class="flex items-start gap-3 text-sm text-slate-600">
          <svg class="w-4 h-4 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          {{ punkt }}
        </li>
        {% endfor %}
      </ul>
    </div>
    <p class="text-xs text-slate-400 mt-4">{{ rr.hinweis }}</p>
    <a href="/en/data-security/" class="inline-block mt-3 text-sm font-semibold text-blue-600 hover:underline">All evidence on one page →</a>
  </div>
</section>

<!-- 4 · Selected services: only the relevant ones -->
<section class="py-16 bg-white">
  <div class="max-w-6xl mx-auto px-5">
    <h2 class="text-2xl font-black text-slate-900 mb-6 text-center">Matching services</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {% for leistungSlug in branche.leistungen %}
      {% set leistung = services | findBySlug(leistungSlug) %}
      {% set ld = leistung.en %}
      <a href="/en/leistungen/{{ leistung.slug }}/" class="reveal reveal-{{ loop.index }} block bg-slate-50 rounded-2xl border border-slate-100 p-5 hover:border-blue-200 transition-colors">
        <p class="font-bold text-slate-800 text-sm mb-2">{{ ld.title or leistung.title }}</p>
        <p class="text-xs text-slate-400 leading-relaxed">{{ (ld.card or leistung.card) | truncate(75) }}</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 5 · Case study from this industry -->
{% set brancheProjekt = null %}
{% for projekt in projects %}
  {% if projekt.branche == branche.slug %}
    {% set brancheProjekt = projekt %}
  {% endif %}
{% endfor %}
{% if brancheProjekt %}
{% set bpd = brancheProjekt.en %}
<section class="py-16 bg-slate-50/50">
  <div class="max-w-3xl mx-auto px-5">
    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4 text-center">Case study from this industry</p>
    <a href="/en/projekte/{{ brancheProjekt.slug }}/" class="reveal block bg-white rounded-2xl border border-slate-100 p-7 shadow-card hover:-translate-y-1 transition-transform">
      <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4">{{ bpd.brancheLabel or brancheProjekt.brancheLabel }}</p>
      <p class="text-4xl font-black text-slate-900">{{ bpd.teaser.zahl or brancheProjekt.teaser.zahl }}</p>
      <p class="text-sm text-blue-600 font-semibold mb-3">{{ bpd.teaser.zahlLabel or brancheProjekt.teaser.zahlLabel }}</p>
      <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ bpd.teaser.text or brancheProjekt.teaser.text }}</p>
      <span class="text-sm font-semibold text-blue-600">View case study →</span>
    </a>
  </div>
</section>
{% endif %}

<!-- 6 · Industry-specific FAQ -->
{% set faqItems = d.faq or branche.faq %}
<section class="py-16 bg-white">
  <div class="max-w-2xl mx-auto px-5">
    <h2 class="text-2xl font-black text-slate-900 mb-6 text-center">Frequently asked questions</h2>
    <div class="space-y-2">
      {% for item in faqItems %}
      <div class="bg-slate-50 rounded-2xl border border-slate-100 overflow-hidden">
        <button type="button" data-faq-toggle aria-expanded="false" class="w-full text-left px-6 py-5 flex items-center justify-between">
          <span class="font-semibold text-slate-800 text-sm">{{ item.q }}</span>
          <svg class="faq-icon w-4 h-4 text-slate-400 flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div class="faq-body hidden px-6 pb-5"><p class="text-sm text-slate-500 leading-relaxed">{{ item.a }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- 7 · CTA block -->
{% set ctaHeadline = "Digitalization for " + (d.kurz or branche.kurz) + "?" %}
{% set ctaSecondaryUrl = "/en/branchen/" %}
{% set ctaSecondaryLabel = "See other industries" %}
{% include "partials/cta.njk" %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": {{ (d.hero or branche.hero) | dump | safe }},
  "provider": { "@type": "Organization", "name": "AIVANCE", "url": "{{ site.url }}" },
  "audience": { "@type": "Audience", "audienceType": {{ (d.title or branche.title) | dump | safe }} },
  "areaServed": "Rhine-Main, Bergstrasse, Rhine-Neckar"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faqItems %}
    { "@type": "Question", "name": {{ item.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} } }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>
