      {% set bd = branche.en %}
      <a href="/en/branchen/{{ branche.slug }}/" class="reveal reveal-{{ loop.index }} block bg-slate-50 rounded-2xl border border-slate-100 p-7 hover:border-blue-200 hover:bg-white hover:shadow-card transition-all">
        <h2 class="text-xl font-bold text-slate-900 mb-2">{{ bd.hero or branche.hero }}</h2>
        <p class="text-sm text-slate-500 leading-relaxed mb-4">{{ bd.heroSatz or branche.heroSatz }}</p>
        <span class="text-sm font-semibold text-blue-600">View industry page →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

