---
layout: layouts/base.njk
pagination:
  data: products
  size: 1
  alias: produkt
  addAllPagesToCollections: true
permalink: "/produkte/{{ produkt.slug }}/"
eleventyComputed:
  enUrl: "/en/produkte/{{ produkt.slug }}/"
  title: "{{ produkt.name }} — AIVANCE"
  metaTitle: "{{ produkt.name }} — AIVANCE"
  metaDescription: "{{ produkt.kurz }}"
  breadcrumb: "{{ produkt.name }}"
---
{% import "partials/logo.njk" as brand %}

<!-- 1 · Hero -->
{% if produkt.hero %}
{# Bespoke Hero (Bildvorlage 21.08.2026) — dieselbe Punktraster-Canvas wie die
   Startseite, über volle Höhe, plus gerader Amber-Linie und verstreuten
   Markern, die auf den Beleg-Knoten zulaufen. #}
<section class="hero product-hero">
  <canvas id="hero-network-canvas" aria-hidden="true"></canvas>
  <div class="hero-veil product-hero-veil" aria-hidden="true"></div>

  <div class="product-hero-inner">
    <a href="/produkte/" class="hero-badge mb-5"><span class="badge-dot"></span>{{ produkt.hero.eyebrow }} / {{ produkt.nummer }}</a>
    <h1 class="headline mb-5">
      {{ produkt.hero.headlineLines[0] }}.<br>{{ produkt.hero.headlineLines[1] }}<span style="color:var(--amber)">.</span>
    </h1>
    <p class="hero-subtext mb-8">{{ produkt.hero.sub }}</p>
  </div>

  <p class="hero-node" aria-hidden="true">{{ produkt.hero.nodeLabel }}</p>

  <p class="product-hero-footer mono text-[11px] tracking-widest uppercase text-ink-muted" aria-hidden="true">{{ produkt.hero.labels | join(' · ') }}</p>
</section>
<script src="/js/hero-network.js" defer></script>
{% else %}
<section class="py-16">
  <div class="max-w-6xl mx-auto px-5">
    <p class="mono text-[11px] tracking-widest uppercase text-ink-muted mb-5">
      <a href="/produkte/" class="hover:underline">Produkte</a> / Produkt {{ produkt.nummer }}
    </p>
    <h1 class="mb-5">{{ brand.productLockup(produkt.kurzname, 36, '30px') }}</h1>
    <p class="max-w-2xl lede mb-5">{{ produkt.kurz }}</p>
    <div class="flex flex-wrap items-center gap-4">
      <p class="mono text-[11px] tracking-widest uppercase text-ink-muted">{{ produkt.tags | join(' · ') }}</p>
      {% if produkt.status %}<span class="mono text-[10px] tracking-widest uppercase text-amber">{{ produkt.status }}</span>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<!-- 2 · Was es macht -->
<section class="py-16">
  <div class="prose-col">
    <h2 class="text-2xl font-black text-slate-900 mb-6">Was {{ produkt.kurzname }} macht</h2>
    <p class="text-sm text-ink-muted leading-relaxed">{{ produkt.text }}</p>
  </div>
</section>

{% if produkt.features %}
<!-- 3 · Funktionen -->
<section class="py-16">
  <div class="max-w-6xl mx-auto px-5">
    <div class="section-head">
      <span class="eyebrow">Funktionen</span>
    </div>
    <div class="grid sm:grid-cols-2 gap-5">
      {% for feature in produkt.features %}
      <div class="card p-6">
        <h3 class="text-base font-semibold tracking-tight mb-2">{{ feature.titel }}</h3>
        <p class="text-sm text-ink-muted leading-relaxed">{{ feature.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if produkt.stack %}
<!-- 4 · Technischer Unterbau -->
<section class="py-16">
  <div class="prose-col">
    <div class="section-head mb-6">
      <span class="eyebrow">Technischer Unterbau</span>
    </div>
    <div class="border border-line divide-y divide-line">
      {% for zeile in produkt.stack %}
      <div class="flex flex-wrap items-baseline justify-between gap-3 px-5 py-3.5">
        <span class="mono text-[11px] tracking-widest uppercase text-ink-muted">{{ zeile.schicht }}</span>
        <span class="text-sm text-ink">{{ zeile.technologie }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set ctaHeadline = produkt.name + " — passt das zu Ihnen?" %}
{% set ctaText = "Im Erstgespräch sagen wir Ihnen ehrlich, ob " + produkt.kurzname + " so passt oder ob Ihr Fall eine eigene Umsetzung braucht." %}
{% set ctaSecondaryUrl = "/produkte/" %}
{% set ctaSecondaryLabel = "Alle Produkte ansehen" %}
{% include "partials/cta.njk" %}
