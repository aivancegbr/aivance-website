            </svg>
            <div class="chat-header-info">
              <div class="chat-header-name">AIVANCE</div>
              <div class="online-indicator">
                <span class="online-dot"></span> Online
              </div>
            </div>
          </div>
          <div class="chat-messages" id="hero-chat-messages"></div>
