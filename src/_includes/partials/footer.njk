{% set t = i18n[lang or 'de'] %}
<footer class="bg-slate-900 text-white pt-14 pb-8">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid md:grid-cols-4 gap-10 mb-10">
      <div>
        <div class="flex items-center gap-2.5 mb-3">
          <img src="/images/logo.jpg" alt="" width="28" height="28" class="h-7 w-7 rounded-lg object-cover" loading="lazy" />
          <span class="font-black text-lg tracking-tight">AIVANCE</span>
        </div>
        <p class="text-sm text-white/50 leading-relaxed max-w-xs">{{ t.footerTagline }} {{ site.region }}.</p>
        <a href="mailto:{{ site.email }}" class="inline-block mt-4 text-sm text-white/40 hover:text-white transition-colors">{{ site.email }}</a>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">{{ t.footerLeistungen }}</p>
        <ul class="space-y-2 text-sm text-white/50">
          {% for cluster in clusters %}
          <li><a href="/leistungen/{{ cluster.slug }}/" class="hover:text-white transition-colors">{{ cluster.title }}</a></li>
          {% endfor %}
          <li><a href="/leistungen/" class="hover:text-white transition-colors">{{ t.footerAlleLeistungen }}</a></li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">{{ t.footerBranchen }}</p>
        <ul class="space-y-2 text-sm text-white/50">
          {% for branche in industries %}
          <li><a href="/branchen/{{ branche.slug }}/" class="hover:text-white transition-colors">{{ branche.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-white/30 mb-4">{{ t.footerUnternehmen }}</p>
        <ul class="space-y-2 text-sm text-white/50">
          <li><a href="/projekte/" class="hover:text-white transition-colors">{{ t.footerProjekte }}</a></li>
          <li><a href="/ueber-uns/" class="hover:text-white transition-colors">{{ t.footerUeberUns }}</a></li>
          <li><a href="/kontakt/" class="hover:text-white transition-colors">{{ t.footerKontakt }}</a></li>
          <li><a href="/datensicherheit/" class="hover:text-white transition-colors">{{ t.footerDatensicherheit }}</a></li>
          <li><a href="/datenschutz/" class="hover:text-white transition-colors">{{ t.footerDatenschutz }}</a></li>
          <li><a href="/impressum/" class="hover:text-white transition-colors">{{ t.footerImpressum }}</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-white/30">
      <p>© <span data-current-year>{{ '' | currentYear }}</span> AIVANCE. {{ t.footerRights }}</p>
      <p>{{ t.footerSlogan }}</p>
    </div>
  </div>
</footer>
