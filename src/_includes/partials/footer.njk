{# Footer — Dunkelvariante der Marke: Ink-Fläche, Amber hellt auf (#F0A75C). #}
{% import "partials/logo.njk" as brand %}
{% set t = i18n[lang or 'de'] %}
{% set isEnPage = lang == 'en' %}
{% set urlBase = '/en' if isEnPage else '' %}
<footer class="site-footer pt-16 pb-8">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid md:grid-cols-4 gap-10 mb-12">
      <div>
        <div class="mb-4">{{ brand.lockup(28, '20px', 'dark', 'GROUNDED AI') }}</div>
        <p class="text-sm text-paper/55 leading-relaxed max-w-xs">{{ t.footerTagline }} {{ site.region }}.</p>
        <a href="mailto:{{ site.email }}" class="mono inline-block mt-5 text-[11px] tracking-widest text-paper/45 transition-colors">{{ site.email }}</a>
      </div>
      <div>
        <p class="footer-eyebrow mb-4">{{ t.footerLeistungen }}</p>
        <ul class="space-y-2.5 text-sm text-paper/55">
          {% for cluster in clusters %}
          <li><a href="{{ urlBase }}/leistungen/{{ cluster.slug }}/" class="transition-colors">{{ cluster.en.title if isEnPage else cluster.title }}</a></li>
          {% endfor %}
          <li><a href="{{ t.urlLeistungen }}" class="transition-colors">{{ t.footerAlleLeistungen }}</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-eyebrow mb-4">{{ t.footerBranchen }}</p>
        <ul class="space-y-2.5 text-sm text-paper/55">
          {% for branche in industries %}
          <li><a href="{{ urlBase }}/branchen/{{ branche.slug }}/" class="transition-colors">{{ branche.en.title if isEnPage else branche.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <p class="footer-eyebrow mb-4">{{ t.footerUnternehmen }}</p>
        <ul class="space-y-2.5 text-sm text-paper/55">
          <li><a href="{{ t.urlProdukte }}" class="transition-colors">{{ t.footerProdukte }}</a></li>
          <li><a href="{{ t.urlProjekte }}" class="transition-colors">{{ t.footerProjekte }}</a></li>
          <li><a href="{{ t.urlUeberUns }}" class="transition-colors">{{ t.footerUeberUns }}</a></li>
          <li><a href="{{ t.urlKontakt }}" class="transition-colors">{{ t.footerKontakt }}</a></li>
          <li><a href="{{ t.urlDatensicherheit }}" class="transition-colors">{{ t.footerDatensicherheit }}</a></li>
          <li><a href="/datenschutz/" class="transition-colors">{{ t.footerDatenschutz }}</a></li>
          <li><a href="/impressum/" class="transition-colors">{{ t.footerImpressum }}</a></li>
        </ul>
      </div>
    </div>
    {# Grant badge must remain in the footer for at least 12 months following the official grant approval date. Confirm the exact removal date from the acceptance email before scheduling removal. #}
    <div class="footer-grant-row">
      <a href="https://elevenlabs.io/startup-grants" target="_blank" rel="noopener noreferrer" class="footer-grant-link"
         aria-label="ElevenLabs Startup Grant Recipient · 2026 ({{ 'opens in new tab' if isEnPage else 'öffnet in neuem Tab' }})">
        <span class="footer-grant-badge">
          <img src="/images/logos/elevenlabs-grants-dark.webp" alt="ElevenLabs Startup Grants Program" width="2324" height="312" loading="lazy">
        </span>
        <span class="footer-grant-label">ElevenLabs Startup Grant Recipient · 2026</span>
      </a>
    </div>
    <div class="border-t border-line-dark pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
      <p class="mono text-[11px] tracking-widest text-paper/35">© <span data-current-year>{{ '' | currentYear }}</span> AIVANCE · {{ t.footerRights }}</p>
      <p class="mono text-[11px] tracking-widest text-paper/35">{{ t.footerSlogan }}</p>
    </div>
  </div>
</footer>
