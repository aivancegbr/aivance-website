{# Leitplanken-Streifen (§ 8): kompakte Komponente auf jeder Cluster-, Leistungs- und Branchenseite — sprachabhängig #}
{% set t = i18n[lang or 'de'] %}
{% set isEn = lang == 'en' %}
<section class="py-12" aria-label="{{ 'Our three guardrails' if isEn else 'Unsere drei Leitplanken' }}">
  <div class="max-w-6xl mx-auto px-5">
    <div class="leitplanken reveal">
      <a href="{{ t.urlDatensicherheit }}" class="block p-5 hover:bg-surface transition-colors">
        <span class="eyebrow mb-3 text-[11px]">{{ 'Data protection' if isEn else 'Datenschutz' }}</span>
        <p class="text-xs text-ink-muted leading-relaxed">{{ 'Hosting in Germany/EU, DPA under Art. 28 GDPR — all evidence on one page.' if isEn else 'Hosting in DE/EU, AVV nach Art. 28 DSGVO — alle Belege auf einer Seite.' }}</p>
      </a>
      <a href="{{ t.urlProjekte }}" class="block p-5 hover:bg-surface transition-colors">
        <span class="eyebrow mb-3 text-[11px]">{{ 'Quality' if isEn else 'Qualität' }}</span>
        <p class="text-xs text-ink-muted leading-relaxed">{{ 'Case studies with before-and-after numbers instead of adjectives.' if isEn else 'Referenzen mit Vorher-nachher-Zahlen statt Adjektiven.' }}</p>
      </a>
      <a href="{{ speedUrl or t.urlLeistungen }}" class="block p-5 hover:bg-surface transition-colors">
        <span class="eyebrow mb-3 text-[11px]">{{ 'Speed' if isEn else 'Geschwindigkeit' }}</span>
        <p class="text-xs text-ink-muted leading-relaxed">{{ 'An honest timeline per service — no blanket promise.' if isEn else 'Ehrlicher Zeitrahmen pro Leistung — kein Pauschalversprechen.' }}</p>
      </a>
    </div>
  </div>
</section>
