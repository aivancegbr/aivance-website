{# Trust-Bar Ebene A — Offizielle Programme (§ 5), direkt unter dem Hero #}
{% set isEn = lang == 'en' %}
<section class="py-12 bg-white border-y border-slate-50" aria-label="{{ 'Official programs' if isEn else 'Offizielle Programme' }}">
  <div class="max-w-4xl mx-auto px-5">
    <p class="programme-eyebrow">{{ 'Official programs' if isEn else 'Offizielle Programme' }}</p>
    <div class="programme-grid">

      <a class="programme-item" href="https://www.nvidia.com/en-us/startups/" target="_blank" rel="noopener"
         title="{{ 'AIVANCE is a member of the NVIDIA Inception program for AI startups.' if isEn else 'AIVANCE ist Mitglied im NVIDIA Inception Programm für KI-Startups.' }}"
         aria-label="{{ 'NVIDIA Inception Member — AIVANCE is a member of the NVIDIA Inception program for AI startups (opens in new tab)' if isEn else 'NVIDIA Inception Member — AIVANCE ist Mitglied im NVIDIA Inception Programm für KI-Startups (öffnet in neuem Tab)' }}">
        <span class="programme-logo">
          <picture>
            <source srcset="/images/logos/nvidia-inception-light.svg" media="(prefers-color-scheme: dark)">
            <img src="/images/logos/nvidia-inception-dark.svg" alt="NVIDIA Inception" width="160" height="30" loading="lazy">
          </picture>
        </span>
        <span class="programme-label">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          Inception Member
        </span>
      </a>

      <a class="programme-item" href="https://aws.amazon.com/activate/" target="_blank" rel="noopener"
         title="{{ 'AIVANCE is a member of the AWS Activate startup program by Amazon Web Services.' if isEn else 'AIVANCE ist Mitglied im AWS Activate Startup-Programm von Amazon Web Services.' }}"
         aria-label="{{ 'AWS Activate Startup — AIVANCE is a member of the AWS Activate startup program (opens in new tab)' if isEn else 'AWS Activate Startup — AIVANCE ist Mitglied im AWS Activate Startup-Programm (öffnet in neuem Tab)' }}">
        <span class="programme-logo">
          <picture>
            <source srcset="/images/logos/aws-activate-light.svg" media="(prefers-color-scheme: dark)">
            <img src="/images/logos/aws-activate-dark.svg" alt="AWS Activate" width="130" height="30" loading="lazy">
          </picture>
        </span>
        <span class="programme-label">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          Activate Startup
        </span>
      </a>

      <a class="programme-item" href="https://www.microsoft.com/en-us/startups" target="_blank" rel="noopener"
         title="{{ 'AIVANCE is a member of the Microsoft for Startups Founders Hub.' if isEn else 'AIVANCE ist Mitglied im Microsoft for Startups Founders Hub.' }}"
         aria-label="{{ 'Microsoft for Startups Founders Hub — AIVANCE is a member of the Founders Hub (opens in new tab)' if isEn else 'Microsoft for Startups Founders Hub — AIVANCE ist Mitglied im Founders Hub (öffnet in neuem Tab)' }}">
        <span class="programme-logo">
          <picture>
            <source srcset="/images/logos/microsoft-startups-light.svg" media="(prefers-color-scheme: dark)">
            <img src="/images/logos/microsoft-startups-dark.svg" alt="Microsoft for Startups" width="220" height="30" loading="lazy">
          </picture>
        </span>
        <span class="programme-label">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          Founders Hub
        </span>
      </a>

    </div>
  </div>
</section>
