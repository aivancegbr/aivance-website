{# Kontaktformular — Bugfix B5: Kernbranchen im Dropdown, Cluster-Interesse zur Lead-Qualifizierung #}
{% set isEn = lang == 'en' %}
<div class="card p-8 reveal">
  <form id="contactForm" action="https://formspree.io/f/mdayjekj" method="POST" novalidate>
    <div class="grid sm:grid-cols-2 gap-4 mb-4">
      <div>
        <label for="cf-name" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'Name *' if isEn else 'Name *' }}</label>
        <input id="cf-name" type="text" name="name" required autocomplete="name" placeholder="{{ 'Your name' if isEn else 'Ihr Name' }}"
               class="w-full px-4 py-3 border border-line bg-surface text-sm placeholder-line-strong focus:outline-none focus:border-ink transition-colors" />
      </div>
      <div>
        <label for="cf-company" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'Company' if isEn else 'Unternehmen' }}</label>
        <input id="cf-company" type="text" name="company" autocomplete="organization" placeholder="{{ 'Company name' if isEn else 'Name des Unternehmens' }}"
               class="w-full px-4 py-3 border border-line bg-surface text-sm placeholder-line-strong focus:outline-none focus:border-ink transition-colors" />
      </div>
    </div>
    <div class="mb-4">
      <label for="cf-email" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'Email *' if isEn else 'E-Mail *' }}</label>
      <input id="cf-email" type="email" name="email" required autocomplete="email" placeholder="{{ 'you@company.com' if isEn else 'sie@unternehmen.de' }}"
             class="w-full px-4 py-3 border border-line bg-surface text-sm placeholder-line-strong focus:outline-none focus:border-ink transition-colors" />
    </div>
    <div class="grid sm:grid-cols-2 gap-4 mb-4">
      <div>
        <label for="cf-industry" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'Industry' if isEn else 'Branche' }}</label>
        <select id="cf-industry" name="branche"
                class="w-full px-4 py-3 border border-line bg-surface text-sm text-ink placeholder-line-strong focus:outline-none focus:border-ink transition-colors">
          {% if isEn %}
          <option value="">Please select …</option>
          <option>Medical & healthcare</option>
          <option>Tax & financial advisory</option>
          <option>Hospitality</option>
          <option>Trades & SMEs</option>
          <option>Other</option>
          {% else %}
          <option value="">Bitte wählen …</option>
          <option>Medizin &amp; Gesundheitswesen</option>
          <option>Steuer- &amp; Finanzberatung</option>
          <option>Gastronomie</option>
          <option>Handwerk &amp; Mittelstand</option>
          <option>Sonstiges</option>
          {% endif %}
        </select>
      </div>
      <div>
        <label for="cf-interest" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'What are you interested in?' if isEn else 'Was interessiert Sie?' }}</label>
        <select id="cf-interest" name="interesse"
                class="w-full px-4 py-3 border border-line bg-surface text-sm text-ink placeholder-line-strong focus:outline-none focus:border-ink transition-colors">
          {% if isEn %}
          <option value="">Please select …</option>
          <option>Visibility (website, photo/video, social media)</option>
          <option>Software & systems (custom software, knowledge systems, voice agents)</option>
          <option>Automation (processes, reporting, integrations)</option>
          <option>Not sure yet — I'd like advice first</option>
          {% else %}
          <option value="">Bitte wählen …</option>
          <option>Sichtbarkeit (Website, Foto/Video, Social Media)</option>
          <option>Software &amp; Systeme (Individualsoftware, Wissenssysteme, Voice Agents)</option>
          <option>Automatisierung (Prozesse, Reporting, Integrationen)</option>
          <option>Noch unklar — erst einmal beraten lassen</option>
          {% endif %}
        </select>
      </div>
    </div>
    <div class="mb-6">
      <label for="cf-message" class="mono block text-[10px] tracking-widest uppercase text-ink-muted mb-2">{{ 'What is this about?' if isEn else 'Worum geht es?' }}</label>
      <textarea id="cf-message" name="message" rows="3" placeholder="{{ 'Briefly describe your situation or project …' if isEn else 'Beschreiben Sie kurz Ihre Situation oder Ihr Vorhaben …' }}"
                class="w-full px-4 py-3 border border-line bg-surface text-sm placeholder-line-strong focus:outline-none focus:border-ink transition-colors resize-none"></textarea>
    </div>
    <button type="submit" class="btn-primary w-full justify-center">
      {{ 'Request a free consultation →' if isEn else 'Kostenloses Erstgespräch anfragen →' }}
    </button>
    <p id="formError" class="hidden mt-3 mono text-[11px] text-red-600" aria-live="assertive"></p>
  </form>
  <div id="successMsg" class="hidden text-center py-6" aria-live="polite">
    <div class="w-11 h-11 rounded-full bg-amber-surface flex items-center justify-center mx-auto mb-4" aria-hidden="true">
      <svg class="w-5 h-5 text-amber" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
    </div>
    <p class="text-lg font-semibold tracking-tight mb-1">{{ 'Thanks — we will be in touch!' if isEn else 'Danke — wir melden uns!' }}</p>
    <p class="mono text-[11px] tracking-widest uppercase text-ink-muted">{{ 'Usually within 24 hours.' if isEn else 'In der Regel innerhalb von 24 Stunden.' }}</p>
  </div>
</div>
