{# Navigation (§ 4): max. 5 Punkte, Mega-Menü für Leistungen, Dropdown für Branchen.
   Sprachabhängige Chrome-Texte und Link-Ziele über i18n[lang] (§ 13 Phase 4).
   Auf EN-Seiten führen alle internen Links auf die englischen Zwillingsseiten.
   Look: Mono-Labels in Versalien, Haarlinien, Amber markiert die aktive Stelle. #}
{% import "partials/logo.njk" as brand %}
{% set t = i18n[lang or 'de'] %}
{% set isEnPage = lang == 'en' %}
{% set urlBase = '/en' if isEnPage else '' %}
{% set isLeistungen = page.url.startsWith('/leistungen/') or page.url.startsWith('/en/leistungen/') %}
{% set isBranchen = page.url.startsWith('/branchen/') or page.url.startsWith('/en/branchen/') %}
{% set isProjekte = page.url.startsWith('/projekte/') or page.url.startsWith('/en/projekte/') %}
{% set isUeberUns = page.url.startsWith('/ueber-uns/') or page.url.startsWith('/en/about/') %}
{% set isHome = page.url == '/' or page.url == '/en/' %}

<header>
<nav id="navbar" class="sticky top-0 z-50 border-b border-line" aria-label="{{ t.navAriaLabel }}">
  <div class="max-w-6xl mx-auto px-5 flex items-center justify-between h-16 relative">

    <a href="{{ t.urlHome }}" aria-label="{{ t.homeAriaLabel }}">
      {{ brand.lockup(27, '19px', 'light', 'GROUNDED AI') }}
    </a>

    <div class="hidden lg:flex items-center gap-7">
      <a href="{{ t.urlHome }}" class="nav-link {{ 'text-amber' if isHome else 'text-ink-muted' }} hover:text-ink transition-colors" {% if isHome %}aria-current="page"{% endif %}>{{ t.navStart }}</a>
      <button type="button" id="megaBtn" class="nav-link inline-flex items-center gap-1.5 {{ 'text-amber' if isLeistungen else 'text-ink-muted' }} hover:text-ink transition-colors"
              aria-expanded="false" aria-controls="megaPanel" {% if isLeistungen %}aria-current="true"{% endif %}>
        {{ t.navLeistungen }}
        <svg class="menu-caret w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
      </button>

      <div class="relative">
        <button type="button" id="branchenBtn" class="nav-link inline-flex items-center gap-1.5 {{ 'text-amber' if isBranchen else 'text-ink-muted' }} hover:text-ink transition-colors"
                aria-expanded="false" aria-controls="branchenPanel" {% if isBranchen %}aria-current="true"{% endif %}>
          {{ t.navBranchen }}
          <svg class="menu-caret w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
        </button>
        <div id="branchenPanel" class="dropdown-panel" role="menu" aria-label="{{ t.branchenAriaLabel }}">
          {% for branche in industries %}
          <a href="{{ urlBase }}/branchen/{{ branche.slug }}/" role="menuitem" class="block px-4 py-3 hover:bg-canvas transition-colors">
            <span class="font-semibold text-sm text-ink block tracking-tight">{{ branche.en.title if isEnPage else branche.title }}</span>
            <span class="mono text-[11px] text-ink-muted">{{ branche.en.hero if isEnPage else branche.hero }}</span>
          </a>
          {% endfor %}
        </div>
      </div>

      <a href="{{ t.urlProjekte }}" class="nav-link {{ 'text-amber' if isProjekte else 'text-ink-muted' }} hover:text-ink transition-colors" {% if isProjekte %}aria-current="true"{% endif %}>{{ t.navProjekte }}</a>
      <a href="{{ t.urlUeberUns }}" class="nav-link {{ 'text-amber' if isUeberUns else 'text-ink-muted' }} hover:text-ink transition-colors" {% if isUeberUns %}aria-current="true"{% endif %}>{{ t.navUeberUns }}</a>
    </div>

    <div class="hidden lg:flex items-center gap-3">
      {% if isEnPage %}{% set langTarget = deUrl or '/' %}{% else %}{% set langTarget = enUrl or '/en/' %}{% endif %}
      <a href="{{ langTarget }}" id="lang-toggle" class="mono inline-flex items-center gap-1 px-3 py-2 border border-line text-[11px] tracking-widest text-ink-muted hover:border-ink hover:text-ink transition-colors"
         lang="{{ 'de' if isEnPage else 'en' }}" hreflang="{{ 'de' if isEnPage else 'en' }}">
        {% if isEnPage %}<span class="text-ink">EN</span><span aria-hidden="true" class="text-line-strong">/</span>DE{% else %}<span class="text-ink">DE</span><span aria-hidden="true" class="text-line-strong">/</span>EN{% endif %}
      </a>
      <a href="{{ t.urlKontakt }}" class="btn-primary" style="padding:11px 16px">{{ t.navKontakt }}</a>
    </div>

    <button type="button" id="menuBtn" class="lg:hidden p-2 text-ink-muted hover:text-ink" aria-expanded="false" aria-controls="mobileOverlay" aria-label="{{ t.menuOpen }}">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  {# Mega-Menü: drei Cluster-Spalten + Case-Study-Teaser (§ 4) #}
  <div id="megaPanel" class="menu-panel" aria-label="{{ t.leistungenAriaLabel }}">
    <div class="max-w-6xl mx-auto px-5 py-9 grid grid-cols-4 gap-8">
      {% for cluster in clusters %}
      <div>
        <span class="eyebrow eyebrow-muted mb-3 text-[11px]">0{{ loop.index }}</span>
        <a href="{{ urlBase }}/leistungen/{{ cluster.slug }}/" class="block font-semibold text-ink text-[15px] tracking-tight mb-1 hover:text-amber transition-colors">{{ cluster.en.title if isEnPage else cluster.title }}</a>
        <p class="text-xs text-ink-muted mb-4">{{ cluster.en.claim if isEnPage else cluster.claim }}</p>
        <ul>
          {% for serviceSlug in cluster.services %}
          {% set service = services | findBySlug(serviceSlug) %}
          <li><a href="{{ urlBase }}/leistungen/{{ service.slug }}/" class="block py-1.5 text-sm text-ink-muted hover:text-amber transition-colors">{{ service.en.navTitle if isEnPage else service.navTitle }}</a></li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
      {% set teaserProjekt = projects[0] %}
      {% set teaserData = teaserProjekt.en.teaser if isEnPage else teaserProjekt.teaser %}
      <a href="{{ urlBase }}/projekte/{{ teaserProjekt.slug }}/" class="block bg-amber-surface border-l-2 border-amber p-5 hover:bg-canvas transition-colors">
        <span class="eyebrow mb-3 text-[11px]">{{ t.caseStudyEyebrow }}</span>
        <p class="text-3xl font-semibold text-ink tracking-tighter">{{ teaserData.zahl }}</p>
        <p class="mono text-[11px] text-amber mb-3">{{ teaserData.zahlLabel }}</p>
        <p class="text-xs text-ink-muted leading-relaxed">{{ teaserData.text }}</p>
        <span class="mono inline-block mt-4 text-[11px] tracking-widest text-ink">{{ t.caseStudyLink }}</span>
      </a>
    </div>
  </div>
</nav>

{# Mobile: Vollbild-Overlay, Cluster als Akkordeon, Sprache + Kontakt unten fixiert (§ 4) #}
<div id="mobileOverlay" class="mobile-overlay lg:hidden" aria-label="{{ t.mobileMenuLabel }}">
  <div class="flex items-center justify-between px-5 h-16 border-b border-line flex-shrink-0">
    <a href="{{ t.urlHome }}">{{ brand.lockup(27, '19px', 'light') }}</a>
    <button type="button" id="menuCloseBtn" class="p-2 text-ink-muted hover:text-ink" aria-label="{{ t.menuClose }}">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto px-5 py-4">
    <a href="{{ t.urlHome }}" class="block py-3.5 border-b border-line text-[15px] font-semibold text-ink tracking-tight">{{ t.navStart }}</a>
    <p class="eyebrow eyebrow-muted mt-6 mb-2 text-[11px]">{{ t.mobileLeistungenLabel }}</p>
    {% for cluster in clusters %}
    <div class="border-b border-line">
      <button type="button" class="mobile-accordion w-full flex items-center justify-between py-3.5 text-left text-[15px] font-semibold text-ink tracking-tight" aria-expanded="false">
        {{ cluster.en.title if isEnPage else cluster.title }}
        <svg class="faq-icon w-4 h-4 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="mobile-accordion-body pb-3">
        <a href="{{ urlBase }}/leistungen/{{ cluster.slug }}/" class="block py-2 pl-3 border-l border-amber text-sm text-amber">{{ t.mobileClusterUebersicht }} {{ cluster.en.title if isEnPage else cluster.title }}</a>
        {% for serviceSlug in cluster.services %}
        {% set service = services | findBySlug(serviceSlug) %}
        <a href="{{ urlBase }}/leistungen/{{ service.slug }}/" class="block py-2 pl-3 border-l border-line text-sm text-ink-muted">{{ service.en.navTitle if isEnPage else service.navTitle }}</a>
        {% endfor %}
      </div>
    </div>
    {% endfor %}

    <p class="eyebrow eyebrow-muted mt-7 mb-2 text-[11px]">{{ t.mobileBranchenLabel }}</p>
    {% for branche in industries %}
    <a href="{{ urlBase }}/branchen/{{ branche.slug }}/" class="block py-3.5 border-b border-line text-[15px] text-ink">{{ branche.en.title if isEnPage else branche.title }}</a>
    {% endfor %}

    <a href="{{ t.urlProjekte }}" class="block py-3.5 mt-6 border-b border-line text-[15px] font-semibold text-ink tracking-tight">{{ t.navProjekte }}</a>
    <a href="{{ t.urlUeberUns }}" class="block py-3.5 border-b border-line text-[15px] font-semibold text-ink tracking-tight">{{ t.navUeberUns }}</a>
  </div>

  <div class="flex items-center gap-3 px-5 py-4 border-t border-line flex-shrink-0 bg-canvas">
    {% if isEnPage %}{% set mobileLangTarget = deUrl or '/' %}{% else %}{% set mobileLangTarget = enUrl or '/en/' %}{% endif %}
    <a href="{{ mobileLangTarget }}" class="mono px-4 py-3.5 border border-line text-[11px] tracking-widest text-ink-muted" lang="{{ 'de' if isEnPage else 'en' }}" hreflang="{{ 'de' if isEnPage else 'en' }}">
      {{ 'EN / DE' if isEnPage else 'DE / EN' }}
    </a>
    <a href="{{ t.urlKontakt }}" class="btn-primary flex-1 justify-center">{{ t.navKontakt }}</a>
  </div>
</div>
</header>
