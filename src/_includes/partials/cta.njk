{# Wiederverwendbarer CTA-Block (T1–T4, jeweils letzte Sektion) — sprachabhängige Defaults über i18n[lang] #}
{% set t = i18n[lang or 'de'] %}
<section class="py-20 md:py-24">
  <div class="max-w-6xl mx-auto px-5">
    <div class="grid md:grid-cols-2 gap-10 md:gap-16 items-end reveal">
      <div>
        <span class="eyebrow mb-5">{{ 'Next step' if lang == 'en' else 'Nächster Schritt' }}</span>
        <h2 class="section-h2">{{ ctaHeadline or t.ctaHeadline }}</h2>
      </div>
      <div>
        <p class="lede mb-8 max-w-md">{{ ctaText or t.ctaText }}</p>
        <div class="flex flex-wrap gap-3">
          <a href="{{ t.urlKontakt }}" class="btn-primary">{{ ctaPrimaryLabel or t.ctaPrimary }}</a>
          <a href="{{ ctaSecondaryUrl or t.urlLeistungen }}" class="btn-ghost">{{ ctaSecondaryLabel or t.ctaSecondary }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
