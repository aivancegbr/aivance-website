{# Wiederverwendbarer CTA-Block (T1–T4, jeweils letzte Sektion) #}
<section class="py-16 bg-white border-t border-slate-100">
  <div class="max-w-3xl mx-auto px-5 text-center reveal">
    <h2 class="text-3xl font-black text-slate-900 mb-3">{{ ctaHeadline or "Ihr Projekt als Nächstes?" }}</h2>
    <p class="text-slate-500 text-sm mb-8 max-w-md mx-auto">{{ ctaText or "Im kostenlosen Erstgespräch hören wir zu, stellen Fragen und sagen Ihnen ehrlich, ob und wie wir helfen können." }}</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/kontakt/" class="px-6 py-3 rounded-xl bg-slate-900 text-white font-semibold text-sm hover:bg-slate-700 transition-colors">Kostenloses Erstgespräch →</a>
      <a href="{{ ctaSecondaryUrl or '/leistungen/' }}" class="px-6 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:bg-slate-50 transition-colors">{{ ctaSecondaryLabel or "Leistungen ansehen" }}</a>
    </div>
  </div>
</section>
